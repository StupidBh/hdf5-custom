{
  "version": 6,
  "configurePresets": [
    {
      "name": "ci-base",
      "displayName": "Basic Config",
      "description": "Common build and install directories",
      "hidden": true,
      "binaryDir": "${sourceParentDir}/build/${presetName}",
      "installDir": "${sourceParentDir}/install/${presetName}"
    },
    {
      "name": "ci-Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "hidden": true
    },
    {
      "name": "ci-Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "hidden": true
    },
    {
      "name": "ci-MSVC",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "ci-GNUC",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "config/toolchain/gcc.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja"
    },
    {
      "name": "ci-HL",
      "hidden": true,
      "cacheVariables": {
        "H5EXAMPLE_BUILD_HL": "ON"
      }
    },
    {
      "name": "ci-CPP",
      "hidden": true,
      "cacheVariables": {
        "H5EXAMPLE_BUILD_CXX": "ON"
      }
    },
    {
      "name": "ci-x64-Debug-MSVC",
      "description": "MSVC for x64 (Debug)",
      "hidden": true,
      "inherits": [
        "ci-base",
        "ci-Debug",
        "ci-MSVC"
      ]
    },
    {
      "name": "ci-x64-Release-MSVC",
      "description": "MSVC for x64 (Release)",
      "hidden": true,
      "inherits": [
        "ci-base",
        "ci-Release",
        "ci-MSVC"
      ]
    },
    {
      "name": "ci-x64-Debug-GNUC",
      "description": "GNUC for x64 (Debug)",
      "hidden": true,
      "inherits": [
        "ci-base",
        "ci-Debug",
        "ci-GNUC"
      ]
    },
    {
      "name": "ci-x64-Release-GNUC",
      "description": "GNUC for x64 (Release)",
      "hidden": true,
      "inherits": [
        "ci-base",
        "ci-Release",
        "ci-GNUC"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "ci-base",
      "configurePreset": "ci-base",
      "hidden": true,
      "verbose": true,
      "jobs": 6
    },
    {
      "name": "ci-x64-Debug-MSVC",
      "configurePreset": "ci-x64-Debug-MSVC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ],
      "configuration": "Debug"
    },
    {
      "name": "ci-x64-Release-MSVC",
      "configurePreset": "ci-x64-Release-MSVC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ],
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ci-x64-Debug-GNUC",
      "configurePreset": "ci-x64-Debug-GNUC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ]
    },
    {
      "name": "ci-x64-Release-GNUC",
      "configurePreset": "ci-x64-Release-GNUC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "ci-base",
      "configurePreset": "ci-base",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      },
      "hidden": true,
      "execution": {
        "noTestsAction": "error",
        "timeout": 600,
        "jobs": 4
      }
    },
    {
      "name": "ci-x64-Debug-MSVC",
      "configurePreset": "ci-x64-Debug-MSVC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ],
      "configuration": "Debug"
    },
    {
      "name": "ci-x64-Release-MSVC",
      "configurePreset": "ci-x64-Release-MSVC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ],
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ci-x64-Debug-GNUC",
      "configurePreset": "ci-x64-Debug-GNUC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ]
    },
    {
      "name": "ci-x64-Release-GNUC",
      "configurePreset": "ci-x64-Release-GNUC",
      "hidden": true,
      "inherits": [
        "ci-base"
      ]
    }
  ],
  "packagePresets": [
    {
      "name": "ci-base",
      "hidden": true,
      "output": {
        "verbose": true
      }
    },
    {
      "name": "ci-x64-Release-MSVC",
      "configurePreset": "ci-x64-Release-MSVC",
      "hidden": true,
      "inherits": "ci-base",
      "configurations": [
        "RelWithDebInfo"
      ]
    },
    {
      "name": "ci-x64-Release-GNUC",
      "configurePreset": "ci-x64-Release-GNUC",
      "hidden": true,
      "inherits": "ci-base"
    }
  ]
}
